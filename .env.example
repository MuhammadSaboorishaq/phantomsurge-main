# ── Database (Vercel Postgres / Neon) ────────────────────────────
# Get this from Vercel Dashboard → Storage → Postgres → .env.local tab
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/phantom_surge?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=generate-a-random-64-char-string-here
ADMIN_EMAIL=admin@phantomsurge.studio
ADMIN_PASSWORD=phantom2026

# ── Vercel Blob (image uploads) ──────────────────────────────────
# Auto-configured when you add Blob storage in Vercel Dashboard → Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_xxxxx

# ── Server (local dev only) ──────────────────────────────────────
PORT=3000
CORS_ORIGIN=*
